# Copy this file to .env and fill in what you have. Everything is optional:
# with nothing set, Saathi runs fully and keeps emails in its built-in outbox.

# AI prescription reading and clash check (free key from https://aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Real email: pick ONE ---
# Brevo (works on Render's free plan, which blocks SMTP). Verify your sender email in Brevo first.
BREVO_API_KEY=
# Resend
# RESEND_API_KEY=
# SMTP, e.g. Gmail with an app password (fine locally, blocked on Render free)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password

# Who emails come from, e.g.  Saathi <you@gmail.com>
MAIL_FROM=

# Send the demo family's emails to your own inbox (you+ravi@..., you+kamla@...)
DEMO_EMAIL=

# Public address used in email links. Render sets RENDER_EXTERNAL_URL automatically.
# BASE_URL=http://localhost:3000

# Turn the one-click demo family on or off
DEMO_MODE=true
