{
  "name": "saathi",
  "version": "1.0.0",
  "description": "Saathi - an elder-first medication and care platform where the elderly person stays in charge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js --dev\" \"vite --strictPort\"",
