    "concurrently": "^9.2.5",
    "lucide-react": "^1.73.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "vite": "^7.3.8"
  }
